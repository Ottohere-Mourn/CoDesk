{
  "case_id": "BC-20",
  "title": "Multi-Period Budget Rollup and Cross-Format Delivery",
  "track": "blind_concurrency",
  "mode": "shared",
  "guest_apps": [
    "LibreOffice Calc"
  ],
  "guest_workspace": "~/workspace",
  "assets": "guest/",
  "prompts": {
    "actor_a": "prompts/actor_a.md",
    "actor_b": "prompts/actor_b.md"
  },
  "oracle": "oracle/oracle.py",
  "oracle_inputs": {
    "truth": "Host source-request revision selection and retention-rule calculations."
  },
  "outputs": [
    "~/workspace/budget_lab/budget_master.ods",
    "~/workspace/budget_lab/out/h1_budget.pdf",
    "~/workspace/budget_lab/out/h2_budget.pdf",
    "~/workspace/budget_lab/out/h1_summary.json",
    "~/workspace/budget_lab/out/h2_summary.json"
  ],
  "expected_steps_per_actor": [
    55,
    90
  ],
  "runner_profile": {
    "mode": "shared",
    "max_cua_calls": null,
    "outer_timeout_s": 7200,
    "countdown_injected": false,
    "xvfb_auth": true,
    "yolo": false,
    "gui_enabled": true,
    "guest_cli_read_write": true
  },
  "guest_setup": {
    "args": [
      "--workspace",
      "/home/user/workspace",
      "--open-calc"
    ]
  },
  "host_snapshots": [
    {
      "guest_path": "/home/user/workspace/budget_lab/budget_master.ods",
      "archive_path": "host-snapshots/budget_master.ods",
      "kind": "state_snapshot"
    },
    {
      "guest_path": "/home/user/workspace/budget_lab/budget_requests.csv",
      "archive_path": "guest-inputs/budget_requests.csv",
      "kind": "fixture"
    },
    {
      "guest_path": "/home/user/workspace/budget_lab/out/h1_summary.json",
      "archive_path": "guest-output/h1_summary.json",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/budget_lab/out/h2_summary.json",
      "archive_path": "guest-output/h2_summary.json",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/budget_lab/out/h1_budget.pdf",
      "archive_path": "guest-output/h1_budget.pdf",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/budget_lab/out/h2_budget.pdf",
      "archive_path": "guest-output/h2_budget.pdf",
      "kind": "deliverable"
    }
  ],
  "host_snapshot_directories": [
    {
      "guest_path": "/home/user/workspace/budget_lab/out",
      "archive_path": "guest-output",
      "kind": "deliverable"
    }
  ]
}
