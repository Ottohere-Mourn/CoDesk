{
  "case_id": "BC-23",
  "title": "Shared Release Manifest and Two-Artifact QA",
  "track": "blind_concurrency",
  "mode": "shared",
  "guest_apps": [
    "GIMP",
    "Google Chrome",
    "Python 3.10"
  ],
  "guest_services": [
    {
      "name": "Release QA",
      "url": "http://127.0.0.1:18223/release"
    }
  ],
  "guest_workspace": "~/workspace",
  "assets": "guest/",
  "prompts": {
    "actor_a": "prompts/actor_a.md",
    "actor_b": "prompts/actor_b.md"
  },
  "oracle": "oracle/oracle.py",
  "outputs": [
    "~/workspace/release_lab/release_manifest.json",
    "~/workspace/release_lab/out/client/client_banner.png",
    "~/workspace/release_lab/out/client/client_thumbnail.png",
    "~/workspace/release_lab/out/server/server_package.zip"
  ],
  "expected_steps_per_actor": [
    55,
    85
  ],
  "runner_profile": {
    "mode": "shared",
    "max_cua_calls": null,
    "outer_timeout_s": 7200,
    "countdown_injected": false,
    "xvfb_auth": true,
    "yolo": false,
    "gui_enabled": true,
    "guest_cli_read_write": true
  },
  "guest_setup": {
    "args": [
      "--workspace",
      "/home/user/workspace",
      "--start-service",
      "--open-browser"
    ]
  },
  "host_snapshots": [
    {
      "guest_path": "/home/user/workspace/release_lab/release_manifest.json",
      "archive_path": "host-snapshots/release_manifest.json",
      "kind": "state_snapshot"
    },
    {
      "guest_path": "/home/user/workspace/release_lab/out/client/client_banner.png",
      "archive_path": "guest-output/out/client/client_banner.png",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/release_lab/out/client/client_thumbnail.png",
      "archive_path": "guest-output/out/client/client_thumbnail.png",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/release_lab/out/server/server_package.zip",
      "archive_path": "guest-output/out/server/server_package.zip",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/release_lab/qa/events.jsonl",
      "archive_path": "host-snapshots/qa_events.jsonl",
      "kind": "service_receipt"
    },
    {
      "guest_path": "/home/user/workspace/release_lab/out/client/client_release.json",
      "archive_path": "guest-output/client_release.json",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/release_lab/out/server/server_release.json",
      "archive_path": "guest-output/server_release.json",
      "kind": "deliverable"
    }
  ],
  "host_http_snapshots": [
    {
      "id": "qa_final",
      "url": "http://127.0.0.1:18223/receipt",
      "archive_path": "host-snapshots/qa-final.json"
    }
  ],
  "host_snapshot_directories": [
    {
      "guest_path": "/home/user/workspace/release_lab/out",
      "archive_path": "guest-output/out",
      "kind": "deliverable"
    }
  ]
}
