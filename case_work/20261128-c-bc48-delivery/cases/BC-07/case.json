{
  "case_id": "BC-07",
  "title": "Two-Phase Dispatch Allocation and Release",
  "track": "blind_concurrency",
  "mode": "shared",
  "guest_apps": ["Google Chrome"],
  "guest_services": [{"name": "North Depot Dispatch Console", "url": "http://127.0.0.1:8092/"}],
  "guest_workspace": "~/workspace",
  "assets": "guest/",
  "prompts": {"actor_a": "prompts/actor_a.md", "actor_b": "prompts/actor_b.md"},
  "oracle": "oracle/oracle.py",
  "oracle_inputs": {"database": "Host-side SQLite copy collected after completion; no Oracle code is staged in the Guest."},
  "outputs": ["~/workspace/dispatch/inbound_audit.json", "~/workspace/dispatch/outbound_audit.json"],
  "runner_profile": {"mode": "shared", "max_cua_calls": null, "outer_timeout_s": 7200, "countdown_injected": false, "xvfb_auth": true, "yolo": false, "gui_enabled": true, "guest_cli_read_write": true},
  "guest_setup": {"args": ["--workspace", "/home/user/workspace", "--start-service", "--open-browser"]},
  "host_snapshots": [
    {"guest_path": "/home/user/workspace/dispatch/rooms.db", "archive_path": "host-snapshots/rooms.db", "kind": "database"},
    {"guest_path": "/home/user/workspace/dispatch/inbound_audit.json", "archive_path": "guest-output/inbound_audit.json", "kind": "deliverable"},
    {"guest_path": "/home/user/workspace/dispatch/outbound_audit.json", "archive_path": "guest-output/outbound_audit.json", "kind": "deliverable"}
  ],
  "host_http_snapshots": [{"id": "dispatch", "url": "http://127.0.0.1:8092/api/receipt", "archive_path": "host-snapshots/dispatch-receipt.json"}]
}
