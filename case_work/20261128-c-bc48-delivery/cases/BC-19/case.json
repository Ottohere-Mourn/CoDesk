{
  "case_id": "BC-19",
  "title": "Shared Risk and Routing Rule Engine Regression",
  "track": "blind_concurrency",
  "mode": "shared",
  "guest_apps": [
    "Google Chrome",
    "Python 3.10"
  ],
  "guest_services": [
    {
      "name": "Rule Engine Console",
      "url": "http://127.0.0.1:18119/health"
    }
  ],
  "guest_workspace": "~/workspace",
  "assets": "guest/",
  "prompts": {
    "actor_a": "prompts/actor_a.md",
    "actor_b": "prompts/actor_b.md"
  },
  "oracle": "oracle/oracle.py",
  "oracle_inputs": {
    "truth": "Host-only expected rule objects and regression results."
  },
  "outputs": [
    "~/workspace/rule_lab/rules.yaml",
    "~/workspace/rule_lab/out/risk_report.json",
    "~/workspace/rule_lab/out/routing_report.json"
  ],
  "expected_steps_per_actor": [
    60,
    90
  ],
  "runner_profile": {
    "mode": "shared",
    "max_cua_calls": null,
    "outer_timeout_s": 7200,
    "countdown_injected": false,
    "xvfb_auth": true,
    "yolo": false,
    "gui_enabled": true,
    "guest_cli_read_write": true
  },
  "guest_setup": {
    "args": [
      "--workspace",
      "/home/user/workspace",
      "--start-service",
      "--open-browser"
    ]
  },
  "host_snapshots": [
    {
      "guest_path": "/home/user/workspace/rule_lab/rules.yaml",
      "archive_path": "host-snapshots/rules.yaml",
      "kind": "state_snapshot"
    },
    {
      "guest_path": "/home/user/workspace/rule_lab/reload_events.jsonl",
      "archive_path": "host-snapshots/reload_events.jsonl",
      "kind": "service_receipt"
    },
    {
      "guest_path": "/home/user/workspace/rule_lab/out/risk_report.json",
      "archive_path": "guest-output/risk_report.json",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/rule_lab/out/routing_report.json",
      "archive_path": "guest-output/routing_report.json",
      "kind": "deliverable"
    }
  ],
  "host_http_snapshots": [
    {
      "id": "rule_health",
      "url": "http://127.0.0.1:18119/health",
      "archive_path": "host-snapshots/rule-health.json"
    },
    {
      "id": "active_rules",
      "url": "http://127.0.0.1:18119/active",
      "archive_path": "host-snapshots/active-rules.json"
    },
    {
      "id": "reload_events",
      "url": "http://127.0.0.1:18119/reload-events",
      "archive_path": "host-snapshots/reload-events.json"
    }
  ],
  "host_snapshot_directories": [
    {
      "guest_path": "/home/user/workspace/rule_lab/out",
      "archive_path": "guest-output",
      "kind": "deliverable"
    }
  ]
}
