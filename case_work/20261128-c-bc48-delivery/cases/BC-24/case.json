{
  "case_id": "BC-24",
  "title": "Cross-Software Subscription and Fulfillment Closeout",
  "track": "blind_concurrency",
  "mode": "shared",
  "guest_apps": [
    "LibreOffice Calc",
    "Google Chrome",
    "Python 3.10"
  ],
  "guest_services": [
    {
      "name": "Closeout Desk",
      "url": "http://127.0.0.1:18224/closeout"
    }
  ],
  "guest_workspace": "~/workspace",
  "assets": "guest/",
  "prompts": {
    "actor_a": "prompts/actor_a.md",
    "actor_b": "prompts/actor_b.md"
  },
  "oracle": "oracle/oracle.py",
  "outputs": [
    "~/workspace/closeout/quarter_closeout.ods",
    "~/workspace/closeout/data/closeout.db",
    "~/workspace/closeout/out/subscription_closeout.json",
    "~/workspace/closeout/out/fulfillment_closeout.json"
  ],
  "expected_steps_per_actor": [
    60,
    95
  ],
  "runner_profile": {
    "mode": "shared",
    "max_cua_calls": null,
    "outer_timeout_s": 7200,
    "countdown_injected": false,
    "xvfb_auth": true,
    "yolo": false,
    "gui_enabled": true,
    "guest_cli_read_write": true
  },
  "guest_setup": {
    "args": [
      "--workspace",
      "/home/user/workspace",
      "--start-service",
      "--open-apps"
    ]
  },
  "host_snapshots": [
    {
      "guest_path": "/home/user/workspace/closeout/data/closeout.db",
      "archive_path": "host-snapshots/closeout.db",
      "kind": "database"
    },
    {
      "guest_path": "/home/user/workspace/closeout/quarter_closeout.ods",
      "archive_path": "host-snapshots/quarter_closeout.ods",
      "kind": "state_snapshot"
    },
    {
      "guest_path": "/home/user/workspace/closeout/out/subscription_closeout.json",
      "archive_path": "guest-output/subscription_closeout.json",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/closeout/out/subscription_closeout.pdf",
      "archive_path": "guest-output/subscription_closeout.pdf",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/closeout/out/fulfillment_closeout.json",
      "archive_path": "guest-output/fulfillment_closeout.json",
      "kind": "deliverable"
    },
    {
      "guest_path": "/home/user/workspace/closeout/out/fulfillment_closeout.pdf",
      "archive_path": "guest-output/fulfillment_closeout.pdf",
      "kind": "deliverable"
    }
  ],
  "host_snapshot_directories": [
    {
      "guest_path": "/home/user/workspace/closeout/out",
      "archive_path": "guest-output",
      "kind": "deliverable"
    }
  ]
}
