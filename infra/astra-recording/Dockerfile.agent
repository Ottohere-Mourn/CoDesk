FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-requests python3-pil ca-certificates bubblewrap curl \
    && rm -rf /var/lib/apt/lists/* && useradd -m -u 1000 -s /bin/bash agent
COPY configs/codex.requirements.toml /etc/codex/requirements.toml
WORKDIR /session
CMD ["python3"]
