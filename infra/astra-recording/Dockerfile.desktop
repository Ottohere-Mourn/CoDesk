FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC
RUN apt-get update && apt-get install -y --no-install-recommends \
    blender freecad qgis python3-qgis python3-pil python3-numpy python3-requests \
    python3-tk xvfb xauth openbox x11-utils xdotool scrot imagemagick \
    dbus-x11 fonts-dejavu-core fonts-liberation fonts-noto-cjk \
    ca-certificates curl git ripgrep unzip poppler-utils bubblewrap iproute2 \
    chromium gimp ffmpeg melt sox libsox-fmt-all sqlite3 graphviz xclip wmctrl \
    inkscape libreoffice-calc libreoffice-writer python3-uno xterm \
    && rm -rf /var/lib/apt/lists/*
ENV DISPLAY=:99 QT_X11_NO_MITSHM=1 LIBGL_ALWAYS_SOFTWARE=1
WORKDIR /workspace
CMD ["sleep", "infinity"]
