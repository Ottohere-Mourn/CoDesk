{
  "suite_id": "SWCUB-V2-SCRIPTED-REAL-GUEST",
  "suite_version": "2.0.0",
  "environment": {
    "adapter": "OSWorldSharedEpisode",
    "release": "osworld-v2.1",
    "guest": "pinned Ubuntu QEMU Guest",
    "actor_mode": "scripted",
    "model_inference": false
  },
  "tasks": [
    {
      "task_id": "SWCUB-FOCUS-ROUTING-001",
      "mechanism": "GUI control contention: shared desktop focus and keyboard routing",
      "runner": "scripts/run_osworld_v2_1_shared_csv.sh",
      "evaluator": "GuestFocusEvaluator",
      "actors": {
        "gui_actor": {"kind": "scripted_gui", "goal": "Document file is exactly Approved\\n"},
        "human_replay": {"kind": "scripted_human_replay", "goal": "Chat file is exactly Review note\\n"}
      },
      "episodes": [
        {"episode_id": "focus-gui-solo", "scenario": "focus-gui-solo", "condition": "solo", "active_actors": ["gui_actor"], "expected": "pass"},
        {"episode_id": "focus-human-solo", "artifact_dir": "outputs/osworld-v2.1/focus-human-solo", "scenario": "focus-human-solo", "condition": "solo", "active_actors": ["human_replay"], "expected": "pass", "legacy_artifact": true},
        {"episode_id": "focus-stale", "artifact_dir": "outputs/osworld-v2.1/focus-stale-attempt-01", "scenario": "focus-stale", "condition": "naive_failure_trigger", "active_actors": ["gui_actor", "human_replay"], "expected": "detected_failure", "legacy_artifact": true},
        {"episode_id": "focus-recovery", "artifact_dir": "outputs/osworld-v2.1/focus-recovery-attempt-01", "scenario": "focus-recovery", "condition": "coordination_recovery", "active_actors": ["gui_actor", "human_replay"], "expected": "pass", "legacy_artifact": true}
      ]
    },
    {
      "task_id": "SWCUB-STALE-MERGE-001",
      "mechanism": "GUI+CLI shared state consistency: stale cached whole-record save loses a CLI revision",
      "runner": "scripts/run_osworld_v2_1_browser.sh",
      "evaluator": "GuestWebStateEvaluator",
      "actors": {
        "gui_actor": {"kind": "scripted_gui", "goal": "gui_status is Approved"},
        "cli_actor": {"kind": "scripted_cli", "goal": "cli_note is Reviewed by CLI"}
      },
      "episodes": [
        {"episode_id": "gui-cli-gui-solo", "scenario": "gui-cli-gui-solo", "condition": "solo", "active_actors": ["gui_actor"], "expected": "pass"},
        {"episode_id": "gui-cli-cli-solo", "scenario": "gui-cli-cli-solo", "condition": "solo", "active_actors": ["cli_actor"], "expected": "pass"},
        {"episode_id": "gui-cli-stale", "scenario": "gui-cli-stale", "condition": "naive_failure_trigger", "active_actors": ["gui_actor", "cli_actor"], "expected": "detected_failure"},
        {"episode_id": "gui-cli-refresh", "scenario": "gui-cli-refresh", "condition": "coordination_recovery", "active_actors": ["gui_actor", "cli_actor"], "expected": "pass"}
      ]
    }
  ]
}
