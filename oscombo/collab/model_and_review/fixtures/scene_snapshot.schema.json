{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoDesk Model-and-Review normalized Blender scene snapshot",
  "type": "object",
  "required": ["schema_version", "scene_name", "active_camera", "objects", "material_colors", "shade_profile", "camera_target_alignment_dot"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_name": {"type": "string"},
    "active_camera": {"type": ["string", "null"]},
    "objects": {"type": "array", "items": {"type": "object", "required": ["name", "type", "location", "dimensions", "materials"]}},
    "material_colors": {"type": "object", "additionalProperties": {"type": "array", "minItems": 4, "maxItems": 4}},
    "shade_profile": {"type": "object", "required": ["inner_radius_bottom_m", "outer_radius_bottom_m", "inner_radius_top_m", "outer_radius_top_m", "z_min_local_m", "z_max_local_m"]},
    "camera_target_alignment_dot": {"type": "number", "minimum": -1, "maximum": 1}
  },
  "additionalProperties": true
}
