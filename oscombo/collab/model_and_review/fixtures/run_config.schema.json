{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDD-MAR-001 run configuration",
  "type": "object",
  "required": ["case_id", "case_version", "run_id", "condition", "actor_ids", "desktop_count", "workspace_backend_id", "workspace_backend_topology", "message_protocol", "budget", "initial_blend_sha256"],
  "properties": {
    "case_id": {"const": "CDD-MAR-001"},
    "case_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "condition": {"enum": ["single_agent", "collaborative_isolated", "collaborative_shared"]},
    "actor_ids": {"type": "array", "items": {"enum": ["A", "B", "S"]}},
    "desktop_count": {"enum": [1, 2]},
    "workspace_backend_id": {"type": "string"},
    "workspace_backend_topology": {"type": "string"},
    "message_protocol": {"type": "string"},
    "budget": {"type": "object"},
    "initial_blend_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
