{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDD-TLA-001 episode manifest",
  "type": "object",
  "required": ["case_id", "case_version", "run_id", "condition", "workspace_backend_id", "fixture_hashes", "actors", "ownership"],
  "properties": {
    "case_id": {"const": "CDD-TLA-001"},
    "case_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "condition": {"enum": ["single_agent", "collaborative_isolated", "collaborative_shared"]},
    "workspace_backend_id": {"type": "string", "minLength": 1},
    "fixture_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "actors": {"type": "array", "items": {"enum": ["A", "B", "S"]}, "minItems": 1, "uniqueItems": true},
    "ownership": {"type": "string", "minLength": 1},
    "provenance": {"type": ["string", "null"]}
  }
}
